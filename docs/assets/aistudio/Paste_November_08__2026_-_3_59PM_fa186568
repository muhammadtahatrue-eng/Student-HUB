-- 11.4 Nullify dangling nullable auth.users references (preserving row & logging audit record)
DO $$
DECLARE
  v_rec RECORD;
BEGIN
  FOR v_rec IN
    SELECT * FROM (VALUES
      ('universities', 'id', 'created_by'),
      ('departments', 'id', 'created_by'),
      ('courses', 'id', 'created_by'),
